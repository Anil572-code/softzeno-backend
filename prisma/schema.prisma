generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRoleName {
  Owner
  Admin
  Manager
  Cashier
  Waiter
  Kitchen
}

enum UserStatus {
  Active
  Inactive
}

enum FiscalYearStatus {
  Open
  Locked
  Closed
}

enum MenuItemStatus {
  Available
  Unavailable
}

enum InventorySection {
  Kitchen
  Bar
}

enum InventoryItemStatus {
  Active
  Inactive
}

enum InventorySettingStatus {
  Active
  Inactive
}

enum InventoryStockActionType {
  Add
  Reduce
  Wastage
  Adjust
  Return
  Opening
  Reserve
  Release
}

enum InventoryReservationStatus {
  Reserved
  Consumed
  Released
}

enum RestaurantTableStatus {
  Free
  Occupied
  Reserved
}

enum PosOrderStatus {
  Draft
  KotSent
  InProgress
  Completed
  Cancelled
}

enum PosOrderItemStatus {
  Draft
  Sent
  Preparing
  Ready
  Served
  Voided
  Cancelled
}

enum KotTicketStatus {
  Sent
  Preparing
  Ready
  Served
  Cancelled
}

enum OrderEventType {
  Created
  ItemAdded
  ItemUpdated
  ItemRemoved
  KotSent
  ItemVoided
  OrderCancelled
  Transferred
  Merged
  Finalized
}

enum RestaurantTableShape {
  round
  square
  rectangle
}

enum CanvasSizeType {
  square
  standard
  wide
  tall
  custom
}

enum FloorBlockType {
  wall
  pillar
  counter
  cashier
  kitchen
  bar
  door
  washroom
  service
  waiting
  plant
  custom
}

enum FloorLayoutColor {
  slate
  zinc
  stone
  violet
  indigo
  blue
  sky
  cyan
  teal
  emerald
  green
  amber
  orange
  red
  rose
  pink
}

enum FloorLineStyle {
  solid
  dashed
  dotted
}

enum FloorTextWeight {
  normal
  bold
  black
}

enum FloorTextAlign {
  left
  center
  right
}

enum CashSessionStatus {
  Open
  Closed
}

enum PaymentMethod {
  Cash
  QR
  Card
  Credit
  Mixed
}

model MenuSection {
  id             String   @id @default(cuid())
  businessId     String
  name           String
  kotDestination String   @default("Kitchen")
  sortOrder      Int      @default(0)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  categories MenuCategory[]
  types      MenuType[]
  items      MenuItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, isActive])
}

model MenuCategory {
  id         String   @id @default(cuid())
  businessId String
  sectionId  String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section MenuSection @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  types   MenuType[]
  items   MenuItem[]

  @@unique([businessId, sectionId, name])
  @@index([businessId])
  @@index([businessId, sectionId])
  @@index([businessId, isActive])
}

model MenuType {
  id         String   @id @default(cuid())
  businessId String
  sectionId  String
  categoryId String
  name       String
  sortOrder  Int      @default(0)
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  section  MenuSection  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  items    MenuItem[]

  @@unique([businessId, categoryId, name])
  @@index([businessId])
  @@index([businessId, sectionId])
  @@index([businessId, categoryId])
  @@index([businessId, isActive])
}

model MenuItem {
  id             String         @id @default(cuid())
  businessId     String
  sectionId      String
  categoryId     String
  typeId         String
  name           String
  price          Decimal        @db.Decimal(12, 2)
  costPrice      Decimal        @default(0) @db.Decimal(12, 2)
  vatIncluded    Boolean        @default(true)
  kotDestination String         @default("Kitchen")
  status         MenuItemStatus @default(Available)
  showInPOS      Boolean        @default(true)
  stock          Int?
  lowStockLimit  Int?
  description    String         @default("")
  imageUrl       String?
  sortOrder      Int            @default(0)
  isTrashed      Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  section  MenuSection  @relation(fields: [sectionId], references: [id], onDelete: Restrict)
  category MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type     MenuType     @relation(fields: [typeId], references: [id], onDelete: Restrict)

  recipeIngredients MenuItemRecipeIngredient[]

  @@unique([businessId, typeId, name])
  @@index([businessId])
  @@index([businessId, sectionId])
  @@index([businessId, categoryId])
  @@index([businessId, typeId])
  @@index([businessId, status])
  @@index([businessId, showInPOS])
  @@index([businessId, isTrashed])
}

model InventoryCategory {
  id         String                 @id @default(cuid())
  businessId String
  section    InventorySection
  name       String
  status     InventorySettingStatus @default(Active)
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  items     InventoryItem[]
  batches   InventoryStockBatch[]
  movements InventoryStockMovement[]

  recipeIngredients MenuItemRecipeIngredient[]

  @@unique([businessId, section, name])
  @@index([businessId])
  @@index([businessId, section])
  @@index([businessId, status])
}

model InventoryItemType {
  id         String                 @id @default(cuid())
  businessId String
  name       String
  status     InventorySettingStatus @default(Active)
  sortOrder  Int                    @default(0)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  items InventoryItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, status])
}

model InventoryStockBatch {
  id                String    @id @default(cuid())
  businessId        String
  itemId            String
  supplierId        String?
  batchNo           String?
  quantityAdded     Decimal   @db.Decimal(12, 4)
  remainingQuantity Decimal   @db.Decimal(12, 4)
  unit              String
  costPrice         Decimal   @default(0) @db.Decimal(12, 2)
  purchaseDate      DateTime  @default(now())
  expiryDate        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  item                InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier            LedgerAccount?     @relation("InventoryStockBatchSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
  inventoryCategoryId String?

  @@index([businessId])
  @@index([businessId, itemId])
  @@index([businessId, supplierId])
  @@index([businessId, expiryDate])
  @@index([businessId, remainingQuantity])
}

model InventoryStockMovement {
  id          String                   @id @default(cuid())
  businessId  String
  itemId      String
  supplierId  String?
  actionType  InventoryStockActionType
  quantity    Decimal                  @db.Decimal(12, 4)
  unit        String
  beforeStock Decimal                  @db.Decimal(12, 4)
  afterStock  Decimal                  @db.Decimal(12, 4)
  reason      String
  note        String?
  performedBy String                   @default("Admin")
  batchNo     String?
  expiryDate  DateTime?
  createdAt   DateTime                 @default(now())

  item                InventoryItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  supplier            LedgerAccount?     @relation("InventoryStockMovementSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
  inventoryCategoryId String?

  @@index([businessId])
  @@index([businessId, itemId])
  @@index([businessId, supplierId])
  @@index([businessId, actionType])
  @@index([businessId, createdAt])
}

model InventoryReservation {
  id              String                     @id @default(cuid())
  businessId      String
  branchId        String?
  orderId         String
  orderItemId     String
  menuItemId      String?
  menuItemName    String
  inventoryItemId String
  inventoryName   String
  quantity        Decimal                    @db.Decimal(12, 4)
  unit            String
  status          InventoryReservationStatus @default(Reserved)
  reservedAt      DateTime                   @default(now())
  consumedAt      DateTime?
  releasedAt      DateTime?
  reason          String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, orderId])
  @@index([businessId, orderItemId])
  @@index([businessId, inventoryItemId])
  @@index([businessId, status])
}

model InventoryStockActionReason {
  id         String                    @id @default(cuid())
  businessId String
  name       String
  actionType InventoryStockActionType?
  status     InventorySettingStatus    @default(Active)
  sortOrder  Int                       @default(0)
  createdAt  DateTime                  @default(now())
  updatedAt  DateTime                  @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, actionType])
  @@index([businessId, status])
}

model InventoryLocation {
  id         String                 @id @default(cuid())
  businessId String
  name       String
  status     InventorySettingStatus @default(Active)
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @updatedAt

  items InventoryItem[]

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, status])
}

model InventorySupplier {
  id            String                 @id @default(cuid())
  businessId    String
  name          String
  phone         String?
  address       String?
  payableAmount Decimal                @default(0) @db.Decimal(12, 2)
  paymentStatus String                 @default("Paid")
  status        InventorySettingStatus @default(Active)
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@unique([businessId, name])
  @@index([businessId])
  @@index([businessId, status])
}

model InventoryItem {
  id                String               @id @default(cuid())
  businessId        String
  name              String
  section           InventorySection
  categoryId        String
  itemTypeId        String
  unit              String
  currentStock      Decimal              @default(0) @db.Decimal(12, 4)
  lowStockLimit     Decimal              @default(0) @db.Decimal(12, 4)
  costPrice         Decimal              @default(0) @db.Decimal(12, 2)
  supplierId        String?
  storageLocationId String?
  trackBatch        Boolean              @default(false)
  trackExpiry       Boolean              @default(false)
  status            InventoryItemStatus  @default(Active)
  statusBeforeTrash InventoryItemStatus?
  isTrashed         Boolean              @default(false)
  trashedAt         DateTime?
  trashedBy         String?
  trashReason       String?
  bottleSizeMl      Int?
  itemsPerPacket    Int?
  lastMovementAt    DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  category                  InventoryCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  itemType                  InventoryItemType          @relation(fields: [itemTypeId], references: [id], onDelete: Restrict)
  supplier                  LedgerAccount?             @relation("InventoryItemSupplier", fields: [supplierId], references: [id], onDelete: SetNull)
  location                  InventoryLocation?         @relation(fields: [storageLocationId], references: [id], onDelete: SetNull)
  batches                   InventoryStockBatch[]
  movements                 InventoryStockMovement[]
  reservations              InventoryReservation[]
  menuItemRecipeIngredients MenuItemRecipeIngredient[]

  @@unique([businessId, section, name])
  @@index([businessId])
  @@index([businessId, section])
  @@index([businessId, categoryId])
  @@index([businessId, itemTypeId])
  @@index([businessId, supplierId])
  @@index([businessId, storageLocationId])
  @@index([businessId, status])
  @@index([businessId, isTrashed])
}

model MenuItemRecipeIngredient {
  id              String   @id @default(cuid())
  businessId      String
  menuItemId      String
  inventoryItemId String
  quantity        Decimal  @db.Decimal(12, 4)
  unit            String
  wastePercent    Decimal  @default(0) @db.Decimal(5, 2)
  sortOrder       Int      @default(0)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  menuItem            MenuItem           @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  inventoryItem       InventoryItem      @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)
  inventoryCategory   InventoryCategory? @relation(fields: [inventoryCategoryId], references: [id])
  inventoryCategoryId String?

  @@unique([businessId, menuItemId, inventoryItemId])
  @@index([businessId])
  @@index([businessId, menuItemId])
  @@index([businessId, inventoryItemId])
  @@index([businessId, isActive])
}

model TableArea {
  id          String   @id @default(cuid())
  businessId  String
  branchId    String?
  name        String
  description String   @default("")
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  isDeleted   Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])

  tables RestaurantTable[]
  layout FloorLayout?

  @@unique([businessId, branchId, name])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, isActive])
  @@index([businessId, isDeleted])
}

model PosOrder {
  id          String         @id @default(cuid())
  businessId  String
  branchId    String?
  terminalId  String?
  tableId     String?
  tableName   String?
  areaId      String?
  areaName    String?
  orderNumber String
  status      PosOrderStatus @default(Draft)

  guestCount Int?

  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal @default(0) @db.Decimal(12, 2)
  vatRate        Decimal @default(13) @db.Decimal(5, 2)
  vatAmount      Decimal @default(0) @db.Decimal(12, 2)
  grandTotal     Decimal @default(0) @db.Decimal(12, 2)

  note         String?
  cancelReason String?

  openedById   String?
  openedByName String?
  closedById   String?
  closedByName String?

  openedAt    DateTime  @default(now())
  lastKotAt   DateTime?
  finalizedAt DateTime?
  cancelledAt DateTime?

  invoiceId     String?
  invoiceNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items   PosOrderItem[]
  tickets KotTicket[]
  events  OrderEvent[]

  @@unique([businessId, branchId, orderNumber])
  @@index([businessId, branchId, status])
  @@index([businessId, branchId, tableId, status])
  @@index([businessId, openedAt])
}

model PosOrderItem {
  id         String  @id @default(cuid())
  orderId    String
  businessId String
  branchId   String?

  menuItemId String?
  name       String
  category   String?
  section    String?
  typeName   String?

  kotDestination String @default("Kitchen")

  qty  Decimal @db.Decimal(10, 2)
  rate Decimal @db.Decimal(12, 2)

  grossAmount Decimal @default(0) @db.Decimal(12, 2)
  netAmount   Decimal @default(0) @db.Decimal(12, 2)

  status PosOrderItemStatus @default(Draft)

  note       String?
  voidReason String?
  voidedById String?
  voidedAt   DateTime?

  sentAt     DateTime?
  preparedAt DateTime?
  servedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order    PosOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kotItems KotTicketItem[]

  @@index([orderId])
  @@index([businessId, branchId])
  @@index([menuItemId])
  @@index([status])
}

model KotTicket {
  id          String          @id @default(cuid())
  businessId  String
  branchId    String?
  orderId     String
  kotNumber   String
  destination String          @default("Kitchen")
  status      KotTicketStatus @default(Sent)

  tableId   String?
  tableName String?
  areaName  String?

  sentById   String?
  sentByName String?
  sentAt     DateTime @default(now())

  preparedAt   DateTime?
  readyAt      DateTime?
  servedAt     DateTime?
  cancelledAt  DateTime?
  cancelReason String?

  printCount    Int       @default(0)
  lastPrintedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order PosOrder        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items KotTicketItem[]

  @@unique([businessId, branchId, kotNumber])
  @@index([businessId, branchId, status])
  @@index([orderId])
  @@index([destination])
}

model KotTicketItem {
  id          String  @id @default(cuid())
  ticketId    String
  orderItemId String
  businessId  String
  branchId    String?

  name String
  qty  Decimal @db.Decimal(10, 2)
  note String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ticket    KotTicket    @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  orderItem PosOrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([orderItemId])
  @@index([businessId, branchId])
}

model OrderEvent {
  id         String         @id @default(cuid())
  businessId String
  branchId   String?
  orderId    String
  eventType  OrderEventType
  message    String

  performedById   String?
  performedByName String?
  performedAt     DateTime @default(now())

  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order PosOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, performedAt])
  @@index([businessId, branchId, eventType])
}

model RestaurantTable {
  id         String                @id @default(cuid())
  businessId String
  branchId   String?
  areaId     String
  name       String
  seats      Int                   @default(4)
  shape      RestaurantTableShape  @default(round)
  status     RestaurantTableStatus @default(Free)

  x      Decimal @default(10) @db.Decimal(6, 2)
  y      Decimal @default(10) @db.Decimal(6, 2)
  width  Decimal @default(9) @db.Decimal(6, 2)
  height Decimal @default(13) @db.Decimal(6, 2)

  activeOrderId     String?
  activeOrderNumber String?
  currentGuests     Int?
  currentAmount     Decimal?  @db.Decimal(12, 2)
  lastOrderAt       DateTime?

  reservationName   String?
  reservationPhone  String?
  reservationGuests Int?
  reservationTime   String?
  reservationNote   String?

  isActive  Boolean  @default(true)
  isDeleted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business  @relation(fields: [businessId], references: [id])
  branch   Branch?   @relation(fields: [branchId], references: [id])
  area     TableArea @relation(fields: [areaId], references: [id], onDelete: Restrict)

  @@unique([businessId, areaId, name])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, areaId])
  @@index([businessId, status])
  @@index([businessId, isDeleted])
}

model FloorLayout {
  id         String         @id @default(cuid())
  businessId String
  branchId   String?
  areaId     String         @unique
  canvasType CanvasSizeType @default(standard)
  width      Int            @default(1200)
  height     Int            @default(720)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  area TableArea @relation(fields: [areaId], references: [id], onDelete: Cascade)

  blocks FloorBlock[]
  zones  FloorZone[]
  lines  FloorLine[]
  texts  FloorText[]

  @@index([businessId])
  @@index([businessId, branchId])
}

model FloorBlock {
  id        String           @id @default(cuid())
  layoutId  String
  areaId    String
  label     String
  blockType FloorBlockType   @default(custom)
  color     FloorLayoutColor @default(slate)
  showLabel Boolean          @default(true)
  x         Decimal          @db.Decimal(6, 2)
  y         Decimal          @db.Decimal(6, 2)
  width     Decimal          @db.Decimal(6, 2)
  height    Decimal          @db.Decimal(6, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  layout FloorLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
  @@index([areaId])
}

model FloorZone {
  id        String           @id @default(cuid())
  layoutId  String
  areaId    String
  name      String
  color     FloorLayoutColor @default(slate)
  opacity   Decimal          @default(0.16) @db.Decimal(4, 2)
  showLabel Boolean          @default(true)
  x         Decimal          @db.Decimal(6, 2)
  y         Decimal          @db.Decimal(6, 2)
  width     Decimal          @db.Decimal(6, 2)
  height    Decimal          @db.Decimal(6, 2)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  layout FloorLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
  @@index([areaId])
}

model FloorLine {
  id        String           @id @default(cuid())
  layoutId  String
  areaId    String
  x1        Decimal          @db.Decimal(6, 2)
  y1        Decimal          @db.Decimal(6, 2)
  x2        Decimal          @db.Decimal(6, 2)
  y2        Decimal          @db.Decimal(6, 2)
  thickness Int              @default(2)
  color     FloorLayoutColor @default(slate)
  style     FloorLineStyle   @default(solid)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  layout FloorLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
  @@index([areaId])
}

model FloorText {
  id         String           @id @default(cuid())
  layoutId   String
  areaId     String
  text       String
  color      FloorLayoutColor @default(slate)
  fontSize   Int              @default(16)
  fontWeight FloorTextWeight  @default(bold)
  align      FloorTextAlign   @default(center)
  background Boolean          @default(false)
  x          Decimal          @db.Decimal(6, 2)
  y          Decimal          @db.Decimal(6, 2)
  width      Decimal          @db.Decimal(6, 2)
  height     Decimal          @db.Decimal(6, 2)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  layout FloorLayout @relation(fields: [layoutId], references: [id], onDelete: Cascade)

  @@index([layoutId])
  @@index([areaId])
}

enum InvoiceDocumentType {
  TaxInvoice
  AbbreviatedTaxInvoice
  CreditNote
  DebitNote
  VoidNote
}

model Business {
  id              String   @id @default(cuid())
  name            String
  legalName       String?
  panVatNumber    String?
  businessType    String
  phone           String?
  email           String?
  address         String?
  defaultCurrency String   @default("NPR")
  timezone        String   @default("Asia/Kathmandu")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branches    Branch[]
  roles       Role[]
  users       User[]
  fiscalYears FiscalYear[]
  terminals   Terminal[]

  tableAreas TableArea[]
  tables     RestaurantTable[]
}

model Branch {
  id           String   @id @default(cuid())
  businessId   String
  name         String
  code         String
  address      String?
  phone        String?
  panVatNumber String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  business    Business     @relation(fields: [businessId], references: [id])
  users       User[]
  terminals   Terminal[]
  fiscalYears FiscalYear[]

  tableAreas TableArea[]
  tables     RestaurantTable[]

  @@unique([businessId, code])
  @@index([businessId])
}

model Terminal {
  id                String    @id @default(cuid())
  businessId        String
  branchId          String
  code              String
  name              String
  deviceFingerprint String?
  isActive          Boolean   @default(true)
  lastSeenAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch   @relation(fields: [branchId], references: [id])

  @@unique([branchId, code])
  @@index([businessId, branchId])
}

model Role {
  id           String       @id @default(cuid())
  businessId   String
  name         UserRoleName
  description  String?
  isSystemRole Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  business    Business         @relation(fields: [businessId], references: [id])
  users       User[]
  permissions RolePermission[]

  @@unique([businessId, name])
}

model RolePermission {
  id         String   @id @default(cuid())
  roleId     String
  module     String
  canView    Boolean  @default(false)
  canCreate  Boolean  @default(false)
  canEdit    Boolean  @default(false)
  canDelete  Boolean  @default(false)
  canExport  Boolean  @default(false)
  canApprove Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  role Role @relation(fields: [roleId], references: [id])

  @@unique([roleId, module])
}

model User {
  id                 String     @id @default(cuid())
  businessId         String
  branchId           String?
  roleId             String
  firstName          String
  middleName         String?
  lastName           String
  username           String
  phone              String?
  email              String?
  passwordHash       String
  status             UserStatus @default(Active)
  mustChangePassword Boolean    @default(true)
  maxDiscountPercent Decimal    @default(0) @db.Decimal(5, 2)
  lastLoginAt        DateTime?
  isDeleted          Boolean    @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  business Business @relation(fields: [businessId], references: [id])
  branch   Branch?  @relation(fields: [branchId], references: [id])
  role     Role     @relation(fields: [roleId], references: [id])

  @@unique([businessId, username])
  @@index([businessId, branchId])
  @@index([roleId])
}

model FiscalYear {
  id            String           @id @default(cuid())
  businessId    String
  branchId      String?
  label         String
  startsAt      DateTime
  endsAt        DateTime
  status        FiscalYearStatus @default(Open)
  invoicePrefix String
  lockedAt      DateTime?
  lockedBy      String?
  closedAt      DateTime?
  closedBy      String?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  business  Business          @relation(fields: [businessId], references: [id])
  branch    Branch?           @relation(fields: [branchId], references: [id])
  sequences InvoiceSequence[]

  @@unique([businessId, branchId, label])
  @@index([businessId, branchId, status])
}

model InvoiceSequence {
  id                String              @id @default(cuid())
  businessId        String
  branchId          String
  terminalId        String?
  fiscalYearId      String
  invoiceType       InvoiceDocumentType
  prefix            String
  currentSequence   Int                 @default(0)
  lastInvoiceNumber String?
  locked            Boolean             @default(false)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  fiscalYear FiscalYear @relation(fields: [fiscalYearId], references: [id])

  @@unique([branchId, fiscalYearId, invoiceType, prefix])
  @@index([businessId, branchId, fiscalYearId])
}

enum InvoiceStatus {
  Draft
  Finalized
  Voided
  Corrected
  CreditNoteIssued
}

enum InvoicePaymentStatus {
  Paid
  PartiallyPaid
  CreditOpen
  CreditPartiallyCleared
  CreditCleared
  Voided
}

enum PaymentMode {
  Cash
  QR
  Card
  Credit
  Mixed
}

enum PaymentReceiptStatus {
  Pending
  Completed
  Voided
  Refunded
  Failed
}

enum SettlementStatus {
  NotRequired
  Pending
  Processing
  PartiallySettled
  Settled
  Failed
  Disputed
}

enum PaymentSource {
  PosInvoice
  LedgerCollection
  SupplierPayment
  StaffSettlement
  Manual
}

enum LedgerAccountType {
  Customer
  Staff
  Supplier
}

enum LedgerEntryKind {
  PosCreditBill
  SupplierPurchase
  Payment
  ManualAdjustment
  OpeningBalance
  Correction
}

enum CbmsStatus {
  Pending
  Synced
  Failed
  Retrying
  Exempt
}

enum AiConversationStatus {
  Active
  Archived
  Deleted
}

enum AiMessageRole {
  System
  User
  Assistant
  Tool
}

enum AiRunStatus {
  Pending
  Running
  Success
  Failed
  Cancelled
  ConfigRequired
}

enum AiToolRunStatus {
  Pending
  Running
  Success
  Failed
  Skipped
}

model AiConversation {
  id            String               @id @default(cuid())
  businessId    String
  branchId      String?
  userId        String?
  agentId       String
  title         String               @default("New AI conversation")
  status        AiConversationStatus @default(Active)
  model         String?
  lastMessageAt DateTime             @default(now())
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  messages AiMessage[]
  runs     AiAgentRun[]

  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, userId])
  @@index([businessId, agentId])
  @@index([businessId, status])
  @@index([lastMessageAt])
}

model AiMessage {
  id             String        @id @default(cuid())
  conversationId String
  businessId     String
  branchId       String?
  userId         String?
  role           AiMessageRole
  content        String
  model          String?
  agentId        String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  conversation AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, userId])
  @@index([businessId, agentId])
  @@index([createdAt])
}

model AiAgentRun {
  id             String      @id @default(cuid())
  conversationId String?
  businessId     String
  branchId       String?
  userId         String?
  agentId        String
  model          String?
  question       String
  questionHash   String?
  contextScope   String?
  status         AiRunStatus @default(Pending)
  inputTokens    Int?
  outputTokens   Int?
  totalTokens    Int?
  errorMessage   String?
  startedAt      DateTime    @default(now())
  completedAt    DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation AiConversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  toolRuns     AiToolRun[]

  @@index([conversationId])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, userId])
  @@index([businessId, agentId])
  @@index([status])
  @@index([startedAt])
}

model AiToolRun {
  id           String          @id @default(cuid())
  agentRunId   String
  businessId   String
  branchId     String?
  userId       String?
  agentId      String
  toolName     String
  status       AiToolRunStatus @default(Pending)
  input        Json?
  output       Json?
  errorMessage String?
  startedAt    DateTime        @default(now())
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  agentRun AiAgentRun @relation(fields: [agentRunId], references: [id], onDelete: Cascade)

  @@index([agentRunId])
  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, userId])
  @@index([businessId, agentId])
  @@index([toolName])
  @@index([status])
  @@index([startedAt])
}

model AiAuditLog {
  id              String   @id @default(cuid())
  businessId      String
  branchId        String?
  userId          String?
  agentId         String?
  conversationId  String?
  agentRunId      String?
  action          String
  entityType      String?
  entityId        String?
  message         String
  metadata        Json?
  performedById   String?
  performedByName String?
  performedAt     DateTime @default(now())
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([businessId])
  @@index([businessId, branchId])
  @@index([businessId, userId])
  @@index([businessId, agentId])
  @@index([conversationId])
  @@index([agentRunId])
  @@index([action])
  @@index([performedAt])
}

model Invoice {
  id                    String               @id @default(cuid())
  businessId            String
  branchId              String
  terminalId            String
  fiscalYearId          String
  invoiceNumber         String
  invoiceType           InvoiceDocumentType  @default(TaxInvoice)
  status                InvoiceStatus        @default(Finalized)
  paymentStatus         InvoicePaymentStatus
  paymentMode           PaymentMode
  orderId               String
  orderNumber           String
  tableId               String?
  tableName             String?
  customerId            String?
  customerName          String?
  customerPhone         String?
  customerPanVat        String?
  grossTotal            Decimal              @db.Decimal(12, 2)
  discountAmount        Decimal              @db.Decimal(12, 2)
  taxableSubtotal       Decimal              @db.Decimal(12, 2)
  vatRate               Decimal              @db.Decimal(5, 2)
  vatAmount             Decimal              @db.Decimal(12, 2)
  grandTotal            Decimal              @db.Decimal(12, 2)
  paidAmount            Decimal              @db.Decimal(12, 2)
  creditAmount          Decimal              @db.Decimal(12, 2)
  cashierId             String
  cashierName           String
  serverId              String?
  serverName            String?
  finalizedAt           DateTime             @default(now())
  printCount            Int                  @default(0)
  lastPrintedAt         DateTime?
  cbmsStatus            CbmsStatus           @default(Pending)
  cbmsSyncedAt          DateTime?
  cbmsResponseCode      String?
  cbmsErrorMessage      String?
  cbmsRetryCount        Int                  @default(0)
  originalInvoiceId     String?
  originalInvoiceNumber String?
  immutableHash         String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt

  items InvoiceItem[]

  @@unique([businessId, branchId, fiscalYearId, invoiceNumber])
  @@index([businessId, branchId, finalizedAt])
  @@index([cbmsStatus, finalizedAt])
}

model InvoiceItem {
  id             String   @id @default(cuid())
  invoiceId      String
  menuItemId     String?
  name           String
  category       String?
  qty            Decimal  @db.Decimal(10, 2)
  rate           Decimal  @db.Decimal(12, 2)
  grossAmount    Decimal  @db.Decimal(12, 2)
  discountAmount Decimal  @default(0) @db.Decimal(12, 2)
  taxableAmount  Decimal  @db.Decimal(12, 2)
  vatAmount      Decimal  @db.Decimal(12, 2)
  netAmount      Decimal  @db.Decimal(12, 2)
  kotNumber      String?
  isVoided       Boolean  @default(false)
  voidReason     String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  invoice Invoice @relation(fields: [invoiceId], references: [id])

  @@index([invoiceId])
}

model PaymentReceipt {
  id                  String               @id @default(cuid())
  businessId          String
  branchId            String
  terminalId          String
  receiptNumber       String
  source              PaymentSource
  sourceReference     String
  invoiceId           String?
  invoiceNumber       String?
  ledgerEntryId       String?
  accountId           String?
  accountName         String?
  method              PaymentMethod
  amount              Decimal              @db.Decimal(12, 2)
  receivedAmount      Decimal?             @db.Decimal(12, 2)
  changeReturn        Decimal?             @db.Decimal(12, 2)
  provider            String?
  referenceNumber     String?
  bankName            String?
  cashSessionId       String?
  status              PaymentReceiptStatus @default(Completed)
  settlementStatus    SettlementStatus     @default(NotRequired)
  settlementBatchId   String?
  settlementReference String?
  settledAt           DateTime?
  settledById         String?
  settledByName       String?
  settlementNote      String?
  receivedById        String
  receivedByName      String
  receivedAt          DateTime             @default(now())
  voidedAt            DateTime?
  voidedById          String?
  voidReason          String?
  refundedAt          DateTime?
  refundedById        String?
  refundReason        String?
  refundedAmount      Decimal?             @db.Decimal(12, 2)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  parts PaymentPart[]

  @@unique([businessId, branchId, receiptNumber])
  @@index([businessId, branchId, receivedAt])
  @@index([businessId, branchId, settlementStatus])
  @@index([businessId, branchId, settlementBatchId])
  @@index([invoiceId])
  @@index([accountId])
}

model PaymentPart {
  id               String        @id @default(cuid())
  paymentReceiptId String
  method           PaymentMethod
  amount           Decimal       @db.Decimal(12, 2)
  provider         String?
  referenceNumber  String?
  bankName         String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  paymentReceipt PaymentReceipt @relation(fields: [paymentReceiptId], references: [id])

  @@index([paymentReceiptId])
}

model CashSession {
  id            String @id @default(cuid())
  businessId    String
  branchId      String
  terminalId    String
  sessionNumber String

  openingCash  Decimal  @default(0) @db.Decimal(12, 2)
  cashIn       Decimal  @default(0) @db.Decimal(12, 2)
  cashOut      Decimal  @default(0) @db.Decimal(12, 2)
  expectedCash Decimal  @default(0) @db.Decimal(12, 2)
  countedCash  Decimal? @db.Decimal(12, 2)
  difference   Decimal? @db.Decimal(12, 2)

  status CashSessionStatus @default(Open)

  openedById   String
  openedByName String
  closedById   String?
  closedByName String?

  openedAt          DateTime  @default(now())
  closedAt          DateTime?
  closeNote         String?
  managerApprovalId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, branchId, terminalId, sessionNumber])
  @@index([businessId, branchId, terminalId, status])
  @@index([businessId, branchId, openedAt])
}

model LedgerAccount {
  id              String            @id @default(cuid())
  businessId      String
  branchId        String?
  type            LedgerAccountType
  name            String
  phone           String?
  email           String?
  address         String?
  creditLimit     Decimal           @default(0) @db.Decimal(12, 2)
  isCreditBlocked Boolean           @default(false)
  blockedReason   String?
  isActive        Boolean           @default(true)
  isArchived      Boolean           @default(false)
  archivedAt      DateTime?
  archivedReason  String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  entries LedgerEntry[]

  inventoryItems          InventoryItem[]          @relation("InventoryItemSupplier")
  inventoryStockBatches   InventoryStockBatch[]    @relation("InventoryStockBatchSupplier")
  inventoryStockMovements InventoryStockMovement[] @relation("InventoryStockMovementSupplier")

  @@index([businessId, type, name])
}

model LedgerEntry {
  id               String          @id @default(cuid())
  businessId       String
  branchId         String
  accountId        String
  date             DateTime        @default(now())
  dueDate          DateTime?
  reference        String
  kind             LedgerEntryKind
  description      String
  debit            Decimal         @default(0) @db.Decimal(12, 2)
  credit           Decimal         @default(0) @db.Decimal(12, 2)
  paymentMethod    PaymentMethod?
  handledById      String
  handledByName    String
  invoiceId        String?
  invoiceNumber    String?
  paymentReceiptId String?
  isVoided         Boolean         @default(false)
  voidReason       String?
  voidedById       String?
  voidedAt         DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([accountId, date])
  @@index([invoiceId])
}

model LedgerAllocation {
  id              String   @id @default(cuid())
  businessId      String
  ledgerAccountId String
  paymentEntryId  String
  targetEntryId   String
  targetReference String
  appliedAmount   Decimal  @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([targetEntryId])
  @@index([paymentEntryId])
}

model AuditTrail {
  id              String   @id @default(cuid())
  businessId      String
  branchId        String?
  terminalId      String?
  action          String
  entityType      String
  entityId        String
  message         String
  performedById   String
  performedByName String
  performedAt     DateTime @default(now())
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([entityType, entityId])
}

model CbmsSyncLog {
  id                 String   @id @default(cuid())
  businessId         String
  branchId           String
  invoiceId          String
  invoiceNumber      String
  status             String
  attemptNumber      Int
  requestPayloadHash String?
  responseCode       String?
  responseMessage    String?
  errorMessage       String?
  attemptedById      String?
  attemptedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([invoiceId, attemptedAt])
}
